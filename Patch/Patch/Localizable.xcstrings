    "Small things, kept up. Track what you do each day and watch the days add up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Dinge, drangeblieben. Erfasse, was du täglich tust, und sieh zu, wie sich die Tage summieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosas pequeñas, mantenidas. Registra lo que haces cada día y mira cómo suman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De petites choses, tenues dans la durée. Notez ce que vous faites chaque jour et voyez les jours s'accumuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccole cose, portate avanti. Registra ciò che fai ogni giorno e guarda i giorni sommarsi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленькие дела, сделанные регулярно. Отслеживайте, что делаете каждый день, и смотрите, как дни складываются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленькі справи, зроблені регулярно. Відстежуйте, що робите щодня, і дивіться, як дні складаються."
          }
        }
      }
    },
