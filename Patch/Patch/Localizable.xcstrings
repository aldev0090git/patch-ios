    "%lld of %lld goals done": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld из %lld целей выполнено"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld з %lld цілей виконано"
          }
        }
      }
    },
    "A date the month doesn't have falls on its last day.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число, которого нет в месяце, приходится на его последний день."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число, якого немає в місяці, припадає на його останній день."
          }
        }
      }
    },
    "A limit. Log each one and the day stays good while you are under it, like at most 2 coffees.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит. Отмечайте каждый раз; день удачный, пока вы его не превысили — например, не больше 2 кофе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт. Відмічайте кожен раз; день вдалий, доки ви не перевищили його — наприклад, не більше 2 кав."
          }
        }
      }
    },
    "A nudge to open Patch and tick off your day — not one per goal.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание открыть Patch и отметить свой день — одно на приложение, а не на каждую цель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування відкрити Patch і відмітити свій день — одне на застосунок, а не на кожну ціль."
          }
        }
      }
    },
    "A short tap when you log something, and a longer one when you finish the day.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткая вибрация, когда вы что-то записываете, и подлиннее, когда завершаете день."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротка вібрація, коли ви щось записуєте, і довша, коли завершуєте день."
          }
        }
      }
    },
