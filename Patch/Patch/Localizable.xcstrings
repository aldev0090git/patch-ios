{
  "sourceLanguage": "en",
  "strings": {
    "%@ a day to make it": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ в день, чтобы успеть"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на день, щоб устигнути"
          }
        }
      }
    },
    "%@ and everything logged against it will be deleted. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» и всё, что по ней записано, будет удалено. Это нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» і все, що за нею записано, буде видалено. Це не можна скасувати."
          }
        }
      }
    },
    "%@ every day": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ каждый день"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ щодня"
          }
        }
      }
    },
