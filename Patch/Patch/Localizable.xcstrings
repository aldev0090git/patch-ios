    "Log each one. The day stays good while you are inside the limit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse jeden einzelnen. Der Tag bleibt gut, solange du im Limit bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra cada uno. El día sigue bien mientras no superes el límite."
