    "Archived goals keep their history and stay out of Today. Restoring one brings it back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Ziele behalten ihren Verlauf und bleiben aus Heute heraus. Wiederherstellen bringt sie zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetivos archivados conservan su historial y no aparecen en Hoy. Al restaurarlos vuelven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objectifs archivés gardent leur historique et disparaissent d'Aujourd'hui. Les restaurer les ramène."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli obiettivi archiviati mantengono la cronologia e restano fuori da Oggi. Ripristinandoli tornano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цели в архиве сохраняют историю и не показываются на экране «Сегодня». Восстановление вернёт цель обратно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цілі в архіві зберігають історію і не показуються на екрані «Сьогодні». Відновлення поверне ціль назад."
          }
        }
      }
    },
    "Bed": {
      "comment": "Name of the icon for a bed.",
