    "Tap an amount and it adds up through the day until you reach it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe eine Menge an; sie summiert sich über den Tag, bis du das Ziel erreichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una cantidad y se va sumando durante el día hasta alcanzarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une quantité : elle s'additionne au fil de la journée jusqu'à l'atteindre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una quantità e si somma durante la giornata fino a raggiungerla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимайте на значения — они складываются в течение дня, пока вы не достигнете цели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкайтеся значень — вони додаються протягом дня, доки ви не досягнете цілі."
          }
        }
      }
    },
