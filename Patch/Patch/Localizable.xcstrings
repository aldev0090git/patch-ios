    "Change the target or the days at any time. Past days keep the target they had.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere Ziel oder Tage jederzeit. Vergangene Tage behalten ihr damaliges Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la meta o los días cuando quieras. Los días pasados conservan la meta que tenían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez la cible ou les jours quand vous voulez. Les jours passés gardent la cible qu'ils avaient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia il traguardo o i giorni quando vuoi. I giorni passati mantengono il traguardo che avevano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте цель или дни когда угодно. Прошлые дни сохраняют свою цель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюйте ціль або дні будь-коли. Минулі дні зберігають свою ціль."
          }
        }
      }
    },
