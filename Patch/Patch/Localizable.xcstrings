    "Reset clears today's entries for that goal. Archiving hides it but keeps its history.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurücksetzen löscht die heutigen Einträge dieses Ziels. Archivieren blendet es aus, behält aber den Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer borra lo registrado hoy en ese objetivo. Archivar lo oculta pero conserva su historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser efface les entrées du jour pour cet objectif. Archiver le masque mais garde son historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azzera cancella le voci di oggi per quell'obiettivo. Archiviare lo nasconde ma ne conserva la cronologia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сбросить» убирает сегодняшние записи этой цели. Архивирование скрывает цель, но сохраняет историю."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скинути» прибирає сьогоднішні записи цієї цілі. Архівування приховує ціль, але зберігає історію."
          }
        }
      }
    },
