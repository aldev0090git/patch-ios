    "Green means a day you finished, orange a day you missed — whichever accent you pick.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grün heißt geschafft, Orange verpasst — unabhängig vom gewählten Akzent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El verde es un día completado y el naranja uno fallado, sea cual sea el acento que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vert signale une journée réussie, l'orange une journée manquée, quel que soit l'accent choisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il verde indica un giorno completato, l'arancione uno mancato, qualunque accento scegli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зелёный всегда означает завершённый день, а оранжевый — пропущенный, при любом акценте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зелений завжди означає завершений день, а помаранчевий — пропущений, хоч який акцент."
          }
        }
      }
    },
