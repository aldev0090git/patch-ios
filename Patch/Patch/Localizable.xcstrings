    "Edit, archive or restore any goal, including ones not scheduled for today.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite, archiviere oder stelle jedes Ziel wieder her — auch solche, die heute nicht anstehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita, archiva o restaura cualquier objetivo, incluidos los que no tocan hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez, archivez ou restaurez n'importe quel objectif, même ceux qui ne sont pas prévus aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica, archivia o ripristina qualsiasi obiettivo, anche quelli non previsti per oggi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить, архивировать или восстановить любую цель, включая те, что не запланированы на сегодня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінити, архівувати або відновити будь-яку ціль, зокрема ті, що не заплановані на сьогодні."
          }
        }
      }
    },
