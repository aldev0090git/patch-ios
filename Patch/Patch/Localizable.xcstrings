    "Change the target or the days at any time. Past days keep the target they had.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте цель или дни когда угодно. Прошлые дни сохраняют свою цель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюйте ціль або дні будь-коли. Минулі дні зберігають свою ціль."
          }
        }
      }
    },
