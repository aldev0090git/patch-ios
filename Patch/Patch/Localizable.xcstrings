    "%@ a day to make it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Tag, um es zu schaffen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al día para lograrlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par jour pour y arriver"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al giorno per farcela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ в день, чтобы успеть"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на день, щоб устигнути"
          }
        }
      }
    },
    "%@ and everything logged against it will be deleted. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und alles, was dafür erfasst wurde, wird gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán %@ y todo lo registrado en él. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et tout ce qui y a été enregistré seront supprimés. C'est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e tutto ciò che vi è stato registrato verranno eliminati. Non è reversibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» и всё, что по ней записано, будет удалено. Это нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» і все, що за нею записано, буде видалено. Це не можна скасувати."
          }
        }
      }
    },
